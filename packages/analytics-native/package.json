{
  "name": "@ishaqyusuf/logly-native",
  "version": "0.1.0",
  "description": "Privacy-safe Expo and React Native analytics delivery for Logly.",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "bun -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "biome check src",
    "prepack": "bun run clean && bun run build",
    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@ishaqyusuf/logly-core": "^0.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
