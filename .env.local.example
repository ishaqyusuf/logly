# Local Docker PostgreSQL. Copy this file to .env.local and replace the auth
# secrets before starting Logly.
LOGLY_DATABASE_URL=postgresql://logly:logly@127.0.0.1:55438/logly
DATABASE_URL=postgresql://logly:logly@127.0.0.1:55438/logly
DASHBOARD_PORT=4201
API_PORT=4202
PORT=4202
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://logly.localhost
BETTER_AUTH_TRUSTED_ORIGINS=https://logly.localhost
NEXT_PUBLIC_DASHBOARD_URL=https://logly.localhost
NEXT_PUBLIC_API_URL=https://logly.localhost
LOGLY_HASH_SECRET=replace-with-an-independent-random-secret
LOGLY_READ_KEY=replace-with-a-local-dashboard-read-key
LOGLY_OWNER_EMAIL=owner@logly.local
LOGLY_OWNER_PASSWORD=replace-with-a-local-only-password
LOGLY_OWNER_NAME=Local Logly Owner
