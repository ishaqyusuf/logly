{
  "name": "@logly/dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build --webpack",
    "dev": "bun --env-file=/dev/null ../../../local-infra-kit/bin/with-env.ts --profile logly -- PORTLESS_WILDCARD=1 PORTLESS_APP_PORT=${PORTLESS_APP_PORT:-${DASHBOARD_PORT:-4201}} portless logly next dev --turbopack",
    "lint": "biome check src",
    "start": "next start -p ${DASHBOARD_PORT:-4201}",
    "test": "find src -name '*.test.ts' -o -name '*.spec.ts' | grep -q . && bun test src || echo 'No tests yet'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ishaqyusuf/logly-next": "workspace:*",
    "@ishaqyusuf/logly-server": "workspace:*",
    "@logly/auth": "workspace:*",
    "@logly/collector": "workspace:*",
    "@logly/db": "workspace:*",
    "@logly/ui": "workspace:*",
    "@logly/utils": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.10",
    "better-auth": "1.7.2",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.17.0",
    "next": "^16.3.0",
    "nuqs": "^2.8.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hotkeys-hook": "^5.3.3",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.9.3"
  }
}
