LOGLY_SERVER_KEY=
LOGLY_READ_KEY=
NEXT_PUBLIC_LOGLY_PROJECT=logly-dashboard
NEXT_PUBLIC_LOGLY_ENDPOINT=/api/analytics
NEXT_PUBLIC_API_URL=
# Email (weekly digest and tracking-alert emails). Sent only when
# VERCEL_ENV=production and both RESEND_API_KEY and EMAIL_FROM are set;
# local and preview never send. CRON_SECRET authenticates /api/cron/email.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
CRON_SECRET=
