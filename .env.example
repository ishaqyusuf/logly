LOGLY_DATABASE_URL=
DATABASE_URL=
DASHBOARD_PORT=4201
API_PORT=4202
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://logly.localhost
BETTER_AUTH_TRUSTED_ORIGINS=https://logly.localhost
# Optional passkey relying party overrides; defaults derive from BETTER_AUTH_URL.
PASSKEY_RP_ID=
PASSKEY_RP_NAME=Logly
PASSKEY_ORIGINS=
NEXT_PUBLIC_DASHBOARD_URL=https://logly.localhost
LOGLY_HASH_SECRET=replace-with-at-least-32-characters
